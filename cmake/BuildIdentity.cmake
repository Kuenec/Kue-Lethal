function(kue_compute_build_identity)
  cmake_parse_arguments(PARSE_ARGV 0 KUE "" "OUTPUT;SOURCE_ROOT;CONFIGURATION"
                        "PROJECT_INPUTS;DEPENDENCY_LABELS;DEPENDENCY_PATHS")
  if(KUE_UNPARSED_ARGUMENTS OR KUE_KEYWORDS_MISSING_VALUES OR
     NOT KUE_OUTPUT OR NOT KUE_SOURCE_ROOT OR NOT KUE_CONFIGURATION)
    message(FATAL_ERROR "kue_compute_build_identity requires complete named arguments")
  endif()

  list(LENGTH KUE_DEPENDENCY_LABELS KUE_DEPENDENCY_LABEL_COUNT)
  list(LENGTH KUE_DEPENDENCY_PATHS KUE_DEPENDENCY_PATH_COUNT)
  if(NOT KUE_DEPENDENCY_LABEL_COUNT EQUAL KUE_DEPENDENCY_PATH_COUNT)
    message(FATAL_ERROR "build-identity dependency labels and paths must correspond exactly")
  endif()

  set(KUE_IDENTITY_RECORDS "${KUE_CONFIGURATION}\n")
  set(KUE_SEEN_INPUT_LABELS)
  foreach(KUE_RELATIVE_INPUT IN LISTS KUE_PROJECT_INPUTS)
    if(IS_ABSOLUTE "${KUE_RELATIVE_INPUT}" OR
       KUE_RELATIVE_INPUT MATCHES "(^|/)\\.\\.?(/|$)")
      message(FATAL_ERROR "build-identity project input is not a canonical relative path: ${KUE_RELATIVE_INPUT}")
    endif()
    set(KUE_INPUT_LABEL "project/${KUE_RELATIVE_INPUT}")
    list(FIND KUE_SEEN_INPUT_LABELS "${KUE_INPUT_LABEL}" KUE_DUPLICATE_INDEX)
    if(NOT KUE_DUPLICATE_INDEX EQUAL -1)
      message(FATAL_ERROR "duplicate build-identity input label: ${KUE_INPUT_LABEL}")
    endif()
    list(APPEND KUE_SEEN_INPUT_LABELS "${KUE_INPUT_LABEL}")
    set(KUE_INPUT_PATH "${KUE_SOURCE_ROOT}/${KUE_RELATIVE_INPUT}")
    if(NOT EXISTS "${KUE_INPUT_PATH}" OR IS_DIRECTORY "${KUE_INPUT_PATH}")
      message(FATAL_ERROR "build-identity project input is not a file: ${KUE_INPUT_PATH}")
    endif()
    file(SHA256 "${KUE_INPUT_PATH}" KUE_INPUT_HASH)
    string(APPEND KUE_IDENTITY_RECORDS "${KUE_INPUT_LABEL}:${KUE_INPUT_HASH}\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KUE_INPUT_PATH}")
  endforeach()

  if(KUE_DEPENDENCY_LABEL_COUNT GREATER 0)
    math(EXPR KUE_LAST_DEPENDENCY_INDEX "${KUE_DEPENDENCY_LABEL_COUNT} - 1")
    foreach(KUE_DEPENDENCY_INDEX RANGE 0 ${KUE_LAST_DEPENDENCY_INDEX})
      list(GET KUE_DEPENDENCY_LABELS ${KUE_DEPENDENCY_INDEX} KUE_DEPENDENCY_LABEL)
      list(GET KUE_DEPENDENCY_PATHS ${KUE_DEPENDENCY_INDEX} KUE_DEPENDENCY_PATH)
      if(NOT KUE_DEPENDENCY_LABEL MATCHES "^[A-Za-z0-9_.+/-]+$")
        message(FATAL_ERROR "invalid build-identity dependency label: ${KUE_DEPENDENCY_LABEL}")
      endif()
      set(KUE_INPUT_LABEL "dependency/${KUE_DEPENDENCY_LABEL}")
      list(FIND KUE_SEEN_INPUT_LABELS "${KUE_INPUT_LABEL}" KUE_DUPLICATE_INDEX)
      if(NOT KUE_DUPLICATE_INDEX EQUAL -1)
        message(FATAL_ERROR "duplicate build-identity input label: ${KUE_INPUT_LABEL}")
      endif()
      list(APPEND KUE_SEEN_INPUT_LABELS "${KUE_INPUT_LABEL}")
      if(NOT EXISTS "${KUE_DEPENDENCY_PATH}" OR IS_DIRECTORY "${KUE_DEPENDENCY_PATH}")
        message(FATAL_ERROR "build-identity dependency input is not a file: ${KUE_DEPENDENCY_PATH}")
      endif()
      file(SHA256 "${KUE_DEPENDENCY_PATH}" KUE_INPUT_HASH)
      string(APPEND KUE_IDENTITY_RECORDS "${KUE_INPUT_LABEL}:${KUE_INPUT_HASH}\n")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KUE_DEPENDENCY_PATH}")
    endforeach()
  endif()

  string(SHA256 KUE_IDENTITY "${KUE_IDENTITY_RECORDS}")
  set(${KUE_OUTPUT} "${KUE_IDENTITY}" PARENT_SCOPE)
endfunction()
